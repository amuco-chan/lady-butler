# Optional fixed key for Lady Butler devices. Normally the app registers a generated sync key automatically.
SYNC_ACCESS_TOKEN=

# Separate API key used only by the Custom GPT Action. Do not reuse the device sync key.
GPT_ACTION_TOKEN=replace-with-a-different-long-random-value

# Added automatically when an Upstash Redis integration is linked in Vercel.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-standard-token

# Free Web Push. Generate one P-256 VAPID key pair and keep the private key secret.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key

# Vercel sends this bearer token to the once-a-day reminder cron route.
CRON_SECRET=replace-with-a-long-random-value

# Optional Gmail deadline scanner. Use a Google Cloud OAuth web client.
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REDIRECT_URI=https://lady-butler.vercel.app/api/gmail-callback

# Secret used to encrypt the stored Gmail refresh token in Upstash.
# If omitted, GPT_ACTION_TOKEN or SYNC_ACCESS_TOKEN is used as a fallback, but a separate long random value is better.
GMAIL_TOKEN_SECRET=replace-with-a-different-long-random-value

# Optional Google Calendar reader. If omitted, the Gmail OAuth client values above are reused.
# Add this redirect URI to the same Google OAuth web client:
# https://lady-butler.vercel.app/api/calendar-callback
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REDIRECT_URI=https://lady-butler.vercel.app/api/calendar-callback
CALENDAR_TOKEN_SECRET=
